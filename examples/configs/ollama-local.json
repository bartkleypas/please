{
  "version": 2,
  "mode": "standalone",
  "server": {
    "provider": "ollama",
    "model": "gemma4:9b",
    "endpoint": "http://localhost:11434",
    "storage_type": "sqlite",
    "vault": "./vault.db",
    "signat_steering": true,
    "ambient_telemetry": false,
    "sandbox_policy": "standard",
    "options": {
      "temperature": 0.7,
      "top_p": 0.9,
      "top_k": 40,
      "num_ctx": 16384,
      "max_tokens": 4096
    }
  }
}
